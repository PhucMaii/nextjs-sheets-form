generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Driver {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(255)
  password String     @db.VarChar(255)
  routes   Route[]
  CodBoard CodBoard[]
}

model User {
  id                 Int     @id @default(autoincrement())
  categoryId         Int
  subCategoryId      Int?
  userPreferenceId   Int? // will change back to force user to have it
  clientName         String  @db.VarChar(255)
  clientId           String  @unique @db.VarChar(255)
  contactNumber      String  @db.VarChar(11)
  deliveryAddress    String  @db.VarChar(255)
  deliveryAddressLng Float?
  deliveryAddressLat Float?
  email              String? @db.VarChar(255)
  password           String  @db.VarChar(255)
  sheetName          String  @db.VarChar(255)
  role               String  @db.VarChar(255)
  createdAt          String?

  category            Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory         SubCategory?     @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  preference          UserPreference?  @relation(fields: [userPreferenceId], references: [id], onDelete: Cascade)
  Orders              Orders[]
  scheduleOrders      ScheduleOrders[]
  routes              UserRoute[]
  unavailableDayRange DayRange[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(255)
  users User[]
  items Item[]
}

model SubCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(255)
  users User[]
  items Item[]
}

model Item {
  id              Int            @id @default(autoincrement())
  name            String         @db.VarChar(255)
  categoryId      Int
  subCategoryId   Int?
  price           Float
  availability    Boolean
  inventoryItemId Int?
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory     SubCategory?   @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model OrderedItems {
  id               Int    @id @default(autoincrement())
  name             String @db.VarChar(255)
  price            Float
  orderId          Int?
  scheduledOrderId Int?
  inventoryItemId  Int?
  expenseId        Int?
  quantity         Int

  Orders         Orders?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ScheduleOrders ScheduleOrders? @relation(fields: [scheduledOrderId], references: [id], onDelete: Cascade)
  expense        Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model Orders {
  id            Int       @id @default(autoincrement())
  orderTime     String
  deliveryDate  String
  note          String
  status        String
  userId        Int
  totalPrice    Float
  updateTime    DateTime?
  isReplacement Boolean?
  isVoid        Boolean?
  createdBy     String?
  updatedBy     String?

  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      OrderedItems[]
  CodBoard   CodBoard?      @relation(fields: [codBoardId], references: [id])
  codBoardId Int?
}

model UserPreference {
  id          Int     @id @default(autoincrement())
  orderType   String?
  paymentType String?
  userId      Int
  User        User[]
}

model ScheduleOrders {
  id         Int            @id @default(autoincrement())
  userId     Int
  totalPrice Float
  day        String
  items      OrderedItems[]
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Route {
  id       Int         @id @default(autoincrement())
  name     String
  day      String
  driverId Int
  clients  UserRoute[]

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model UserRoute {
  userId  Int
  routeId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  route   Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([userId, routeId])
}

model DayRange {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  userId    Int
  createdAt String?
  createdBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id           Int      @id @default(autoincrement())
  updatedBy    String
  updatedAt    DateTime
  announcement String
}

model CodBoard {
  id        Int      @id @default(autoincrement())
  createdAt String
  createdBy String
  updatedAt String?
  updatedBy String?
  date      String
  note      String
  cash      Float
  status    String
  driverId  Int
  orders    Orders[]

  driver  Driver    @relation(fields: [driverId], references: [id])
  expense Expense[]
}

model PaymentMethod {
  id           Int       @id @default(autoincrement())
  createdAt    String
  createdBy    String
  name         String
  balance      Float
  type         String
  updatedAt    String?
  updatedBy    String?
  transactions Expense[]
}

model Expense {
  id              Int     @id @default(autoincrement())
  createdAt       String
  createdBy       String
  amount          Float
  description     String
  spentBy         String
  date            String
  paymentMethodId Int
  codBoardId      Int?
  invoice         String?
  status          String?

  paymentMethod PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  codBoard      CodBoard?       @relation(fields: [codBoardId], references: [id])
  orderedItems  OrderedItems[]
  vendors       VendorExpense[]
}

model VendorExpense {
  expenseId Int
  vendorId  Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([expenseId, vendorId])
}

model Vendor {
  id          Int    @id @default(autoincrement())
  name        String
  address     String
  addressLat  Float?
  addressLng  Float?
  phoneNumber String
  createdAt   String
  createdBy   String
  joinedDate  String

  inventoryItems InventoryItem[]
  expense        VendorExpense[]
}

model InventoryItem {
  id        Int    @id @default(autoincrement())
  name      String
  vendorId  Int
  quantity  Int
  unitPrice Float
  unit      String

  createdAt String
  createdBy String

  sellingItems Item[]
  solItems     OrderedItems[]

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}
