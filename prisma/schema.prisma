generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Driver {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(255)
  password String     @db.VarChar(255)
  routes   Route[]
  CodBoard CodBoard[]
}

model User {
  id                  Int               @id @default(autoincrement())
  categoryId          Int?
  clientName          String            @db.VarChar(255)
  clientId            String            @unique @db.VarChar(255)
  contactNumber       String            @db.VarChar(11)
  deliveryAddress     String            @db.VarChar(255)
  password            String            @db.VarChar(255)
  sheetName           String            @db.VarChar(255)
  role                String            @db.VarChar(255)
  email               String?           @db.VarChar(255)
  userPreferenceId    Int?
  subCategoryId       Int?
  deliveryAddressLat  Float?
  deliveryAddressLng  Float?
  createdAt           String?
  type                String?
  guestSessionId      String?
  contactName         String?
  category            Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory         SubCategory?      @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  preference          UserPreference?   @relation(fields: [userPreferenceId], references: [id], onDelete: Cascade)
  Orders              Orders[]
  scheduleOrders      ScheduleOrders[]
  routes              UserRoute[]
  unavailableDayRange DayRange[]
  printStatements     ClientStatement[]
  cart                Cart[]
  cheques             Cheque[]
}

model Category {
  id                Int                 @id @default(autoincrement())
  name              String              @unique @db.VarChar(255)
  users             User[]
  items             Item[]
  itemType_category ItemType_Category[]
}

model SubCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(255)
  users User[]
  items Item[]
}

model Item {
  id              Int            @id @default(autoincrement())
  name            String         @db.VarChar(255)
  categoryId      Int
  price           Float
  subCategoryId   Int?
  availability    Boolean
  inventoryItemId Int?
  inventoryUnitId Int?
  prevPrice       Float?
  isShowDiscount  Boolean?
  options         Option[]
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory     SubCategory?   @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  inventoryUnit   InventoryUnit? @relation(fields: [inventoryUnitId], references: [id])

  @@index([categoryId])
}

model OrderedItems {
  id               Int             @id @default(autoincrement())
  name             String          @db.VarChar(255)
  price            Float
  orderId          Int?
  quantity         Int
  scheduledOrderId Int?
  expenseId        Int?
  inventoryItemId  Int?
  fifoId           Int?
  inventoryUnitId  Int?
  isShowDiscount   Boolean?
  prevPrice        Float?
  isCustomAmount   Boolean?
  cost             Float?
  profit           Float?
  Orders           Orders?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  expense          Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fifo             Fifo?           @relation(fields: [fifoId], references: [id])
  inventoryUnit    InventoryUnit?  @relation(fields: [inventoryUnitId], references: [id])
  inventoryItem    InventoryItem?  @relation(fields: [inventoryItemId], references: [id])
  ScheduleOrders   ScheduleOrders? @relation(fields: [scheduledOrderId], references: [id])
}

model Orders {
  id                Int            @id @default(autoincrement())
  orderTime         String
  deliveryDate      String
  note              String
  status            String
  userId            Int
  totalPrice        Float
  isReplacement     Boolean?
  isVoid            Boolean?
  updateTime        DateTime?
  createdBy         String?
  updatedBy         String?
  codBoardId        Int?
  GST               Float?
  PST               Float?
  subTotal          Float?
  discount          Float?
  isAffectInventory Boolean?
  shippingFee       Float?
  type              String?
  deliveredBy       String?
  addedToCODBy      String?
  user              User?          @relation(fields: [userId], references: [id])
  items             OrderedItems[]
  CodBoard          CodBoard?      @relation(fields: [codBoardId], references: [id])
}

model UserPreference {
  id          Int     @id @default(autoincrement())
  orderType   String?
  paymentType String?
  userId      Int
  User        User[]
}

model ScheduleOrders {
  id            Int            @id @default(autoincrement())
  totalPrice    Float
  userId        Int
  day           String
  items         OrderedItems[]
  positionIndex PositionIndex? @relation("ScheduledOrderIndex")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PositionIndex {
  id               Int            @id @default(autoincrement())
  scheduledOrderId Int            @unique
  index            Int
  scheduledOrder   ScheduleOrders @relation("ScheduledOrderIndex", fields: [scheduledOrderId], references: [id], onDelete: Cascade)
}

model Route {
  id       Int         @id @default(autoincrement())
  day      String
  driverId Int
  name     String
  clients  UserRoute[]
  driver   Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model UserRoute {
  userId  Int
  routeId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  route   Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([userId, routeId])
}

model DayRange {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  userId    Int
  createdAt String?
  createdBy String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id           Int      @id @default(autoincrement())
  updatedBy    String
  updatedAt    DateTime
  announcement String
}

model CodBoard {
  id        Int       @id @default(autoincrement())
  createdAt String
  createdBy String
  updatedAt String?
  updatedBy String?
  date      String
  note      String
  cash      Float
  status    String
  driverId  Int?
  orders    Orders[]
  driver    Driver?   @relation(fields: [driverId], references: [id])
  expense   Expense[]
}

model PaymentMethod {
  id           Int       @id @default(autoincrement())
  createdAt    String
  createdBy    String
  name         String
  balance      Float
  type         String
  updatedAt    String?
  updatedBy    String?
  transactions Expense[]
}

model Expense {
  id              Int             @id @default(autoincrement())
  createdAt       String
  createdBy       String
  amount          Float
  description     String
  spentBy         String
  paymentMethodId Int
  date            String
  codBoardId      Int?
  invoice         String?
  status          String?
  GST             Float?
  PST             Float?
  subTotal        Float?
  paymentMethod   PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  codBoard        CodBoard?       @relation(fields: [codBoardId], references: [id])
  orderedItems    OrderedItems[]
  vendors         VendorExpense[]
}

model VendorExpense {
  expenseId Int
  vendorId  Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([expenseId, vendorId])
}

model Vendor {
  id          Int             @id @default(autoincrement())
  name        String
  address     String
  phoneNumber String
  createdAt   String
  createdBy   String
  joinedDate  String
  addressLat  Float?
  addressLng  Float?
  expense     VendorExpense[]
  vendorItem  VendorItem[]
}

model InventoryItem {
  id            Int              @id @default(autoincrement())
  name          String
  createdAt     String
  createdBy     String
  hasGST        Boolean?
  hasPST        Boolean?
  typeId        Int?
  color         String?
  indexPos      Int?
  image         String?
  isPromotion   Boolean?
  promotionId   Int?
  promoIndexPos Int?
  item          Item[]
  vendorItem    VendorItem[]
  fifo          Fifo[]
  OrderedItems  OrderedItems[]
  preference    ItemPreference[]
  options       Option[]
  promotion     Promotion?       @relation(fields: [promotionId], references: [id])
  type          ItemType?        @relation(fields: [typeId], references: [id])
}

model ItemPreference {
  id              Int           @id @default(autoincrement())
  image           String
  inventoryItemId Int
  typeId          Int
  description     String
  isBestSeller    Boolean
  createdAt       String?
  createdBy       String?
  price           Float
  isShowDiscount  Boolean?
  prevPrice       Float?
  inventoryUnitId Int
  name            String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            ItemType      @relation(fields: [typeId], references: [id], onDelete: Cascade)
  cartItems       CartItem[]
  inventoryUnit   InventoryUnit @relation(fields: [inventoryUnitId], references: [id])
}

model ItemType {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  createdAt         String?
  createdBy         String?
  icon              String?
  priority          Int?
  rows              Int?
  itemPreferences   ItemPreference[]
  inventoryItems    InventoryItem[]
  itemType_category ItemType_Category[]
}

model ItemType_Category {
  itemTypeId Int
  categoryId Int
  priority   Int
  itemType   ItemType @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([itemTypeId, categoryId])
}

model VendorItem {
  id              Int             @id @default(autoincrement())
  inventoryItemId Int
  vendorId        Int
  quantity        Float
  createdAt       String
  createdBy       String
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  vendor          Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  fifo            Fifo[]
  unit            InventoryUnit[]
}

model Fifo {
  id              Int            @id @default(autoincrement())
  inventoryItemId Int
  vendorItemId    Int
  quantity        Float
  createdAt       String
  createdBy       String
  price           Float?
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  vendorItem      VendorItem     @relation(fields: [vendorItemId], references: [id], onDelete: Cascade)
  orderedItems    OrderedItems[]
}

model InventoryUnit {
  id              Int              @id @default(autoincrement())
  vendorItemId    Int
  unit            String
  unitPrice       Float
  ratio           Float
  createdAt       String
  createdBy       String
  sellingItem     Item[]
  itemOptions     Option[]
  vendorItem      VendorItem       @relation(fields: [vendorItemId], references: [id], onDelete: Cascade)
  orderedItems    OrderedItems[]
  cartItems       CartItem[]
  itemPreferences ItemPreference[]
}

model Action {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.Text
  date        String
  createdAt   String
  createdBy   String?
}

model Cheque {
  id           Int     @id @default(autoincrement())
  fileKeyFront String
  fileKeyBack  String?
  month        String
  year         String
  chequeNumber String?
  amount       Float
  createdAt    String
  createdBy    String
  userId       Int
  user         User    @relation(fields: [userId], references: [id])
}

model ClientStatement {
  id        Int     @id @default(autoincrement())
  month     String
  isPrinted Boolean
  userId    Int
  createdAt String
  printedBy String
  updatedBy String?
  user      User    @relation(fields: [userId], references: [id])
}

model CartItem {
  id               Int            @id @default(autoincrement())
  quantity         Int
  cartId           Int
  itemPreferenceId Int
  createdAt        String
  createdBy        String
  inventoryUnitId  Int
  inventoryUnit    InventoryUnit  @relation(fields: [inventoryUnitId], references: [id])
  itemPreference   ItemPreference @relation(fields: [itemPreferenceId], references: [id], onDelete: Cascade)
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

model Cart {
  id             Int        @id @default(autoincrement())
  subtotal       Float
  GST            Float
  PST            Float
  shippingFee    Float
  totalPrice     Float
  note           String?
  userId         Int?
  discount       Float
  createdAt      String
  createdBy      String
  guestSessionId String?
  items          CartItem[]
  user           User?      @relation(fields: [userId], references: [id])
}

model Promotion {
  id         Int             @id @default(autoincrement())
  title      String
  status     String
  createdAt  String
  rows       Int
  priority   Int
  visibility Boolean?
  items      InventoryItem[]
}

model Option {
  id              Int           @id @default(autoincrement())
  name            String
  price           Float
  prevPrice       Float?
  isShowDiscount  Boolean?
  availability    Boolean
  unitId          Int
  itemId          Int
  inventoryItemId Int
  unit            InventoryUnit @relation(fields: [unitId], references: [id])
  item            Item          @relation(fields: [itemId], references: [id])
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
}
