generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Company {
  id        Int    @id @default(autoincrement())
  name      String
  address   String?
  contactNumber  String?
  email      String?
  createdAt String
  createdBy String

  actions           Action[]
  announcements     Announcement[]
  users             User[]
  employees         Employee[]
  orders            Orders[]
  transactions      Expense[]
  vendors           Vendor[]
  routes            Route[]
  shiftSessions     ShiftSession[]
  inventoryItems    InventoryItem[]
  codBoards         CodBoard[]
  categories        Category[]
  fixedTransactions FixedTransaction[]
  paymentMethods    PaymentMethod[]
  purchaseOrders    PO[]
  poItems           POItem[]
  itemTypes         ItemType[]
  promotions        Promotion[]
  sellingItems      Item[]
  orderedItems      OrderedItems[]
  cheques           Cheque[]
  clientStatements  ClientStatement[]
  inventoryUnits    InventoryUnit[]
  fifos              Fifo[]
  vendorItems       VendorItem[]
  scheduledOrders   ScheduleOrders[]
  lossReports       LossReport[]
  unavailableRanges DayRange[]
  companyPages      CompanyPage[]
  quotes            Quote[]
  quoteItems        QuoteItem[]
}

model PageView {
  id            Int      @id @default(autoincrement())
  title         String
  createdAt     String?

  companyPages  CompanyPage[]
  adminPages    AdminPage[]
}

model CompanyPage {
  id        Int      @id  @default(autoincrement())
  companyId Int
  pageId    Int

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pageView  PageView    @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model AdminPage {
  id           Int     @id  @default(autoincrement())
  employeeId   Int
  pageId       Int

  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pageView     PageView   @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Employee {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(255)
  password     String  @db.VarChar(255)
  hourlyRate   Float?
  employeeCode    String
  email        String?
  notification Json?
  role         String?
  companyId    Int
  createdAt    String?
  createdBy    String?

  shiftSessions ShiftSession[]
  routes        Route[]
  CodBoard      CodBoard[]
  adminPages     AdminPage[]

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Driver {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(255)
  password     String  @db.VarChar(255)
  hourlyRate   Float?
  notification Json?
  role         String?

  shiftSessions ShiftSession[]
  routes        Route[]
  CodBoard      CodBoard[]
}

model User {
  id                 Int     @id @default(autoincrement())
  categoryId         Int?
  companyId          Int?
  clientName         String  @db.VarChar(255)
  clientId           String  @unique @db.VarChar(255)
  contactNumber      String  @db.VarChar(11)
  deliveryAddress    String  @db.VarChar(255)
  password           String  @db.VarChar(255)
  sheetName          String? @db.VarChar(255)
  role               String  @db.VarChar(255)
  email              String? @db.VarChar(255)
  userPreferenceId   Int?
  subCategoryId      Int?
  deliveryAddressLat Float?
  deliveryAddressLng Float?
  createdAt          String?
  type               String?
  guestSessionId     String?
  contactName        String?

  category    Category?       @relation(fields: [categoryId], references: [id])
  subCategory SubCategory?    @relation(fields: [subCategoryId], references: [id])
  preference  UserPreference? @relation(fields: [userPreferenceId], references: [id])
  company     Company?        @relation(fields: [companyId], references: [id])

  Orders              Orders[]
  scheduleOrders      ScheduleOrders[]
  routes              UserRoute[]
  unavailableDayRange DayRange[]
  printStatements     ClientStatement[]
  cart                Cart[]
  cheques             Cheque[]
  quotes              Quote[]
}

model Quote {
  id        Int         @id @default(autoincrement())
  companyId Int?
  userId    Int
  status    QuoteStatus @default(DRAFT)
  subtotal  Float
  PST       Float
  GST       Float
  total     Float
  note      String
  createdAt String
  createdBy String

  items QuoteItem[]

  user User @relation(fields: [userId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id])
}

model QuoteItem {
  id              Int @id @default(autoincrement())
  companyId       Int?
  quoteId         Int
  inventoryItemId Int
  inventoryUnitId Int
  quantity        Int
  price           Int

  quote         Quote         @relation(fields: [quoteId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])
  company       Company?      @relation(fields: [companyId], references: [id])
}

model Category {
  id        Int    @id @default(autoincrement())
  name      String @unique @db.VarChar(255)
  companyId Int?

  company           Company?            @relation(fields: [companyId], references: [id])
  users             User[]
  items             Item[]
  itemType_category ItemType_Category[]
}

model SubCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(255)
  users User[]
  items Item[]
}

model Item {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  companyId       Int?
  categoryId      Int?
  price           Float
  availability    Boolean
  inventoryItemId Int?
  inventoryUnitId Int?
  isShowDiscount  Boolean?
  prevPrice       Float?
  image           String?
  promotionId     Int? // support for only item in website category
  isBestSeller    Boolean?

  options  Option[]
  cartItem CartItem[]

  promotion     Promotion?     @relation(fields: [promotionId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  inventoryUnit InventoryUnit? @relation(fields: [inventoryUnitId], references: [id])
  company        Company?      @relation(fields: [companyId], references: [id])
  SubCategory   SubCategory?   @relation(fields: [subCategoryId], references: [id])
  subCategoryId Int?

  @@index([categoryId])
  @@index([inventoryItemId])
  @@index([inventoryUnitId])
}

model OrderedItems {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(255)
  price            Float
  companyId        Int?
  orderId          Int?
  quantity         Int
  scheduledOrderId Int?
  expenseId        Int?
  inventoryItemId  Int?
  fifoId           Int?
  inventoryUnitId  Int?
  isShowDiscount   Boolean?
  prevPrice        Float?
  isCustomAmount   Boolean?
  cost             Float?
  profit           Float?
  option           Json?

  Orders         Orders?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  expense        Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fifo           Fifo?           @relation(fields: [fifoId], references: [id])
  inventoryUnit  InventoryUnit?  @relation(fields: [inventoryUnitId], references: [id])
  inventoryItem  InventoryItem?  @relation(fields: [inventoryItemId], references: [id])
  ScheduleOrders ScheduleOrders? @relation(fields: [scheduledOrderId], references: [id])
  company         Company?       @relation(fields: [companyId], references: [id])

  @@index([orderId])
  @@index([companyId])
  @@index([expenseId])
  @@index([scheduledOrderId])
  @@index([inventoryItemId])
  @@index([orderId, inventoryItemId])
}

model Orders {
  id                Int            @id @default(autoincrement())
  orderTime         String
  deliveryDate      String
  note              String
  status            String
  userId            Int
  totalPrice        Float
  isReplacement     Boolean?
  isVoid            Boolean?
  updateTime        DateTime?
  createdBy         String?
  updatedBy         String?
  codBoardId        Int?
  GST               Float?
  PST               Float?
  subTotal          Float?
  discount          Float?
  isAffectInventory Boolean?
  shippingFee       Float?
  type              String?
  deliveredBy       String?
  deliveredAt       String?
  addedToCODBy      String?
  insertedAt        String?
  insertedBy        String?
  companyId         Int?
  user              User?          @relation(fields: [userId], references: [id])
  company           Company?       @relation(fields: [companyId], references: [id])
  items             OrderedItems[]
  CodBoard          CodBoard?      @relation(fields: [codBoardId], references: [id])

  @@index([deliveryDate, status])
  @@index([userId])
  @@index([companyId])
}

model UserPreference {
  id          Int     @id @default(autoincrement())
  orderType   String?
  paymentType String?
  userId      Int
  User        User[]
}

model ScheduleOrders {
  id            Int            @id @default(autoincrement())
  companyId     Int?
  totalPrice    Float
  userId        Int
  day           String
  items         OrderedItems[]
  positionIndex PositionIndex? @relation("ScheduledOrderIndex")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company?   @relation(fields: [companyId], references: [id])

  @@index([userId])
}

model PositionIndex {
  id               Int            @id @default(autoincrement())
  scheduledOrderId Int            @unique
  index            Int
  scheduledOrder   ScheduleOrders @relation("ScheduledOrderIndex", fields: [scheduledOrderId], references: [id], onDelete: Cascade)
}

model Route {
  id            Int            @id @default(autoincrement())
  day           String
  driverId      Int
  employeeId    Int?
  name          String
  companyId     Int?
  clients       UserRoute[]
  shiftSessions ShiftSession[]

  driver   Driver    @relation(fields: [driverId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserRoute {
  userId  Int
  routeId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  route   Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([userId, routeId])
}

model DayRange {
  id         Int      @id @default(autoincrement())
  companyId  Int?
  startDate  DateTime
  endDate    DateTime
  userId     Int
  createdAt  String?
  createdBy  String?
  isArchived Boolean?

  company    Company? @relation(fields: [companyId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id           Int      @id @default(autoincrement())
  companyId    Int?
  updatedBy    String
  updatedAt    DateTime
  announcement String

  company      Company?   @relation(fields: [companyId], references: [id])
}

model CodBoard {
  id         Int     @id @default(autoincrement())
  createdAt  String
  createdBy  String
  updatedAt  String?
  updatedBy  String?
  date       String
  note       String
  cash       Float
  status     String
  driverId   Int?
  employeeId Int?
  companyId  Int?

  orders  Orders[]
  expense Expense[]

  driver   Driver?   @relation(fields: [driverId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model PaymentMethod {
  id        Int     @id @default(autoincrement())
  createdAt String
  createdBy String
  name      String
  balance   Float
  type      String
  updatedAt String?
  updatedBy String?
  companyId Int?

  transactions      Expense[]
  fixedTransactions FixedTransaction[]

  company Company? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model FixedTransaction {
  id                       Int     @id @default(autoincrement())
  title                    String
  companyId                Int?
  defaultSubtotal          Float?
  defaultAmount            Float?
  defaultPST               Float?
  defaultGST               Float?
  recurrence               String // monthly, quarterly, etc
  initialDueDate           String
  nextDueDate              String
  lastGeneratedAt          String?
  note                     String?
  createdAt                String
  createdBy                String
  updatedAt                String?
  updatedBy                String?
  status                   String
  defaultSpentBy           String?
  defaultTransactionStatus String? // Paid & Unpaid
  paymentMethodId          Int

  transactions Expense[]

  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Expense {
  id                 Int     @id @default(autoincrement())
  createdAt          String
  createdBy          String
  subTotal           Float?
  PST                Float?
  GST                Float?
  amount             Float
  discount           Float?
  description        String
  spentBy            String
  paymentMethodId    Int
  date               String
  codBoardId         Int?
  invoice            String?
  status             String?
  fixedTransactionId Int?
  companyId          Int?

  paymentMethod    PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  codBoard         CodBoard?         @relation(fields: [codBoardId], references: [id])
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderedItems     OrderedItems[]
  vendors          VendorExpense[]
  shifts           ShiftSession[]
  purchaseOrders   PO[]
  fixedTransaction FixedTransaction? @relation(fields: [fixedTransactionId], references: [id])
}

model VendorExpense {
  expenseId Int
  vendorId  Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([expenseId, vendorId])
}

model Vendor {
  id          Int     @id @default(autoincrement())
  name        String
  address     String
  addressLat  Float?
  addressLng  Float?
  phoneNumber String?
  createdAt   String
  createdBy   String
  joinedDate  String
  email       String?
  companyId   Int?

  company        Company?        @relation(fields: [companyId], references: [id])
  expense        VendorExpense[]
  vendorItem     VendorItem[]
  purchaseOrders PO[]
}

model InventoryItem {
  id            Int      @id @default(autoincrement())
  name          String
  sku           String?  @unique
  supplierSku   String?
  createdAt     String
  createdBy     String
  hasGST        Boolean?
  hasPST        Boolean?
  typeId        Int?
  color         String?
  indexPos      Int?
  image         String?
  isPromotion   Boolean?
  promotionId   Int?
  promoIndexPos Int?
  companyId     Int?

  company      Company?         @relation(fields: [companyId], references: [id])
  item         Item[]
  vendorItem   VendorItem[]
  fifo         Fifo[]
  OrderedItems OrderedItems[]
  preference   ItemPreference[]
  options      Option[]
  poItems      POItem[]
  lossReports  LossReport[]
  quoteItems   QuoteItem[]

  promotion Promotion? @relation(fields: [promotionId], references: [id])
  type      ItemType?  @relation(fields: [typeId], references: [id])

  @@index([indexPos])
  @@index([promoIndexPos])
  @@index([typeId, indexPos])
}

model ItemPreference {
  id              Int           @id @default(autoincrement())
  image           String
  inventoryItemId Int
  typeId          Int
  description     String
  isBestSeller    Boolean
  createdAt       String?
  createdBy       String?
  price           Float
  isShowDiscount  Boolean?
  prevPrice       Float?
  inventoryUnitId Int
  name            String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            ItemType      @relation(fields: [typeId], references: [id], onDelete: Cascade)
  inventoryUnit   InventoryUnit @relation(fields: [inventoryUnitId], references: [id])
}

model ItemType {
  id        Int     @id @default(autoincrement())
  companyId Int?
  name      String  @unique
  createdAt String?
  createdBy String?
  icon      String?
  priority  Int?
  rows      Int?

  company           Company?            @relation(fields: [companyId], references: [id])
  itemPreferences   ItemPreference[]
  inventoryItems    InventoryItem[]
  itemType_category ItemType_Category[]
}

model ItemType_Category {
  itemTypeId Int
  categoryId Int
  priority   Int
  itemType   ItemType @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([itemTypeId, categoryId])
}

model VendorItem {
  id              Int    @id @default(autoincrement())
  companyId       Int?
  inventoryItemId Int
  vendorId        Int
  quantity        Float
  createdAt       String
  createdBy       String

  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  vendor        Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  company       Company?        @relation(fields: [companyId], references: [id])

  fifo          Fifo[]
  unit          InventoryUnit[]

  @@index([vendorId])
  @@index([inventoryItemId, vendorId])
}

model Fifo {
  id              Int            @id @default(autoincrement())
  companyId       Int?
  inventoryItemId Int
  vendorItemId    Int
  quantity        Float
  createdAt       String
  createdBy       String
  price           Float?
  
  vendorItem      VendorItem     @relation(fields: [vendorItemId], references: [id], onDelete: Cascade)
  orderedItems    OrderedItems[]

  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  company         Company?       @relation(fields: [companyId], references: [id])
}

model InventoryUnit {
  id           Int    @id @default(autoincrement())
  vendorItemId Int
  companyId    Int?
  unit         String
  unitPrice    Float  @db.Double
  ratio        Float
  createdAt    String
  createdBy    String

  company      Company?       @relation(fields: [companyId], references: [id])

  sellingItem     Item[]
  itemOptions     Option[]
  vendorItem      VendorItem       @relation(fields: [vendorItemId], references: [id], onDelete: Cascade)
  orderedItems    OrderedItems[]
  itemPreferences ItemPreference[]
  poItems         POItem[]
  lossReports     LossReport[]
  quoteItems      QuoteItem[]

  @@index([vendorItemId])
}

model Action {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.Text
  companyId   Int?
  date        String
  createdAt   String
  createdBy   String?

  company     Company?  @relation(fields: [companyId], references: [id])
}

model Cheque {
  id           Int     @id @default(autoincrement())
  companyId    Int?
  fileKeyFront String
  fileKeyBack  String?
  month        String?
  year         String
  startDate    String?
  endDate      String?
  chequeNumber String?
  amount       Float
  createdAt    String
  createdBy    String
  userId       Int
  
  user         User    @relation(fields: [userId], references: [id])
  company      Company?  @relation(fields: [companyId], references: [id])
}

model ClientStatement {
  id        Int     @id @default(autoincrement())
  companyId Int?
  month     String
  isPrinted Boolean
  userId    Int
  createdAt String
  printedBy String
  updatedBy String?

  user      User    @relation(fields: [userId], references: [id])
  company   Company?  @relation(fields: [companyId], references: [id])
}

model CartItem {
  id        Int    @id @default(autoincrement())
  quantity  Int
  cartId    Int
  itemId    Int
  createdAt String
  createdBy String
  option    Json?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

model Cart {
  id             Int        @id @default(autoincrement())
  subtotal       Float
  GST            Float
  PST            Float
  shippingFee    Float
  totalPrice     Float
  note           String?
  userId         Int?
  discount       Float
  createdAt      String
  createdBy      String
  guestSessionId String?
  items          CartItem[]
  user           User?      @relation(fields: [userId], references: [id])
}

model Promotion {
  id         Int      @id @default(autoincrement())
  companyId  Int?
  title      String
  status     String
  createdAt  String
  rows       Int
  priority   Int
  visibility Boolean?
  isWebsite  Boolean?

  items        InventoryItem[]
  websiteItems Item[]

  company     Company?      @relation(fields: [companyId], references: [id])
}

model Option {
  id              Int      @id @default(autoincrement())
  name            String
  price           Float
  prevPrice       Float?
  isShowDiscount  Boolean?
  availability    Boolean
  inventoryItemId Int
  createdAt       String?
  createdBy       String?

  unitId Int
  itemId Int

  unit          InventoryUnit @relation(fields: [unitId], references: [id])
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model ShiftSession {
  id         Int      @id @default(autoincrement())
  driverId   Int
  employeeId Int?
  routeId    Int?
  date       String
  startedAt  String
  endedAt    String?
  hours      Float?
  isActive   Boolean?
  cost       Float?
  status     String?
  expenseId  Int?
  role       String?
  companyId  Int?

  driver   Driver    @relation(fields: [driverId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  expense  Expense?  @relation(fields: [expenseId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  route    Route?    @relation(fields: [routeId], references: [id])
}

model PO {
  id         Int     @id @default(autoincrement())
  companyId  Int?
  poNumber   String?
  vendorId   Int
  status     String
  discount   Float?
  totalCost  Float
  tax        Float
  subtotal   Float
  estArrival String
  createdAt  String
  createdBy  String
  receivedAt String?
  note       String?
  expenseId  Int?

  company Company? @relation(fields: [companyId], references: [id])

  vendor  Vendor   @relation(fields: [vendorId], references: [id])
  poItems POItem[]
  expense Expense? @relation(fields: [expenseId], references: [id])

  @@index([vendorId])
}

model POItem {
  id              Int     @id @default(autoincrement())
  inventoryItemId Int
  companyId       Int?
  poId            Int
  orderedQty      Float
  receivedQty     Float?
  rejectedQty     Float?
  tax             Float?
  costPerItem     Float
  note            String?
  inventoryUnitId Int

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])
  po            PO            @relation(fields: [poId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id])

  @@index([poId])
  @@index([inventoryItemId])
}

model LossReport {
  id              Int     @id @default(autoincrement())
  companyId       Int?
  inventoryItemId Int
  quantityLost    Int
  inventoryUnitId Int
  totalCost       Float?
  lossType        String
  description     String?
  reportedDate    String
  reportedBy      String
  createdAt       String
  createdBy       String

  medias Media[]

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])
  company       Company?      @relation(fields: [companyId], references: [id])
}

model Media {
  id           Int    @id @default(autoincrement())
  type         String
  fileKey      String
  createdAt    String
  createdBy    String
  lossReportId Int?

  lossReport LossReport? @relation(fields: [lossReportId], references: [id], onDelete: Cascade)
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}