generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Driver {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(255)
  password String     @db.VarChar(255)
  routes   Route[]
  CodBoard CodBoard[]
}

model User {
  id                 Int     @id @default(autoincrement())
  categoryId         Int?
  subCategoryId      Int?
  userPreferenceId   Int? // will change back to force user to have it
  clientName         String  @db.VarChar(255)
  clientId           String  @unique @db.VarChar(255)
  contactNumber      String  @db.VarChar(11)
  deliveryAddress    String  @db.VarChar(255)
  deliveryAddressLng Float?
  deliveryAddressLat Float?
  email              String? @db.VarChar(255)
  password           String  @db.VarChar(255)
  sheetName          String  @db.VarChar(255)
  role               String  @db.VarChar(255)
  guestSessionId     String? // Only useful for first time placing order
  createdAt          String?
  type               String?

  category            Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory         SubCategory?      @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  preference          UserPreference?   @relation(fields: [userPreferenceId], references: [id], onDelete: Cascade)
  Orders              Orders[]
  scheduleOrders      ScheduleOrders[]
  routes              UserRoute[]
  unavailableDayRange DayRange[]
  printStatements     ClientStatement[]
  cart                Cart[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(255)
  users User[]
  items Item[]
}

model SubCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(255)
  users User[]
  items Item[]
}

model Item {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  categoryId      Int
  subCategoryId   Int?
  price           Float
  prevPrice       Float?
  isShowDiscount  Boolean?
  availability    Boolean
  inventoryItemId Int?
  inventoryUnitId Int?

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory   SubCategory?   @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  inventoryUnit InventoryUnit? @relation(fields: [inventoryUnitId], references: [id])

  @@index([categoryId])
}

model OrderedItems {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(255)
  price            Float
  orderId          Int?
  scheduledOrderId Int?
  fifoId           Int?
  expenseId        Int?
  quantity         Int
  isShowDiscount   Boolean?
  prevPrice        Float?
  inventoryUnitId  Int?
  inventoryItemId  Int?
  isCustomAmount   Boolean?
  cost             Float?
  profit            Float?

  Orders         Orders?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  expense        Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fifo           Fifo?           @relation(fields: [fifoId], references: [id])
  inventoryUnit  InventoryUnit?  @relation(fields: [inventoryUnitId], references: [id])
  inventoryItem  InventoryItem?  @relation(fields: [inventoryItemId], references: [id])
  ScheduleOrders ScheduleOrders? @relation(fields: [scheduledOrderId], references: [id])
}

model Orders {
  id                Int       @id @default(autoincrement())
  orderTime         String
  deliveryDate      String
  note              String
  status            String
  userId            Int
  subTotal          Float?
  discount          Float?
  PST               Float?
  GST               Float?
  totalPrice        Float
  type              String?
  updateTime        DateTime?
  isReplacement     Boolean?
  isVoid            Boolean?
  isAffectInventory Boolean?
  createdBy         String?
  updatedBy         String?
  deliveredBy       String?
  addedToCODBy      String?

  user       User?          @relation(fields: [userId], references: [id])
  items      OrderedItems[]
  CodBoard   CodBoard?      @relation(fields: [codBoardId], references: [id])
  codBoardId Int?
}

model UserPreference {
  id          Int     @id @default(autoincrement())
  orderType   String?
  paymentType String?
  userId      Int
  User        User[]
}

model ScheduleOrders {
  id         Int            @id @default(autoincrement())
  userId     Int
  totalPrice Float
  day        String
  items      OrderedItems[]

  positionIndex PositionIndex? @relation("ScheduledOrderIndex")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PositionIndex {
  id               Int @id @default(autoincrement())
  scheduledOrderId Int @unique
  index            Int

  scheduledOrder ScheduleOrders @relation("ScheduledOrderIndex", fields: [scheduledOrderId], references: [id], onDelete: Cascade)
}

model Route {
  id       Int         @id @default(autoincrement())
  name     String
  day      String
  driverId Int
  clients  UserRoute[]

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model UserRoute {
  userId  Int
  routeId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  route   Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([userId, routeId])
}

model DayRange {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  userId    Int
  createdAt String?
  createdBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id           Int      @id @default(autoincrement())
  updatedBy    String
  updatedAt    DateTime
  announcement String
}

model CodBoard {
  id        Int      @id @default(autoincrement())
  createdAt String
  createdBy String
  updatedAt String?
  updatedBy String?
  date      String
  note      String
  cash      Float
  status    String
  driverId  Int?
  orders    Orders[]

  driver  Driver?   @relation(fields: [driverId], references: [id])
  expense Expense[]
}

model PaymentMethod {
  id           Int       @id @default(autoincrement())
  createdAt    String
  createdBy    String
  name         String
  balance      Float
  type         String
  updatedAt    String?
  updatedBy    String?
  transactions Expense[]
}

model Expense {
  id              Int     @id @default(autoincrement())
  createdAt       String
  createdBy       String
  subTotal        Float?
  PST             Float?
  GST             Float?
  amount          Float
  description     String
  spentBy         String
  date            String
  paymentMethodId Int
  codBoardId      Int?
  invoice         String?
  status          String?

  paymentMethod PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  codBoard      CodBoard?       @relation(fields: [codBoardId], references: [id])
  orderedItems  OrderedItems[]
  vendors       VendorExpense[]
}

model VendorExpense {
  expenseId Int
  vendorId  Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([expenseId, vendorId])
}

model Vendor {
  id          Int    @id @default(autoincrement())
  name        String
  address     String
  addressLat  Float?
  addressLng  Float?
  phoneNumber String
  createdAt   String
  createdBy   String
  joinedDate  String

  expense    VendorExpense[]
  vendorItem VendorItem[]
}

model InventoryItem {
  id        Int      @id @default(autoincrement())
  name      String
  hasPST    Boolean?
  hasGST    Boolean?
  createdAt String
  createdBy String

  item         Item[]
  vendorItem   VendorItem[]
  fifo         Fifo[]
  OrderedItems OrderedItems[]
  preference   ItemPreference[]
}

model ItemPreference {
  id             Int      @id @default(autoincrement())
  image          String
  name           String
  description    String
  isBestSeller   Boolean
  price          Float
  isShowDiscount Boolean?
  prevPrice      Float?

  createdAt String?
  createdBy String?

  inventoryItemId Int
  inventoryUnitId Int
  typeId          Int

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type          ItemType      @relation(fields: [typeId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])
}

model ItemType {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  icon      String?
  createdAt String?
  createdBy String?

  itemPreferences ItemPreference[]
}

model VendorItem {
  id              Int    @id @default(autoincrement())
  inventoryItemId Int
  vendorId        Int
  quantity        Float // hidden
  createdAt       String
  createdBy       String

  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  vendor        Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  fifo          Fifo[]
  unit          InventoryUnit[]
}

model Fifo {
  id              Int    @id @default(autoincrement())
  inventoryItemId Int
  vendorItemId    Int
  quantity        Float
  price           Float?
  createdAt       String
  createdBy       String

  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  vendorItem    VendorItem     @relation(fields: [vendorItemId], references: [id], onDelete: Cascade)
  orderedItems  OrderedItems[]
}

model InventoryUnit {
  id           Int    @id @default(autoincrement())
  vendorItemId Int
  unit         String
  unitPrice    Float  @db.Double
  ratio        Float
  createdAt    String
  createdBy    String
  sellingItem  Item[]

  vendorItem      VendorItem       @relation(fields: [vendorItemId], references: [id], onDelete: Cascade)
  orderedItems    OrderedItems[]
  cartItems       CartItem[]
  itemPreferences ItemPreference[]
}

model Action {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.Text
  date        String
  createdAt   String
  createdBy   String?
}

model ClientStatement {
  id        Int     @id @default(autoincrement())
  month     String
  isPrinted Boolean
  userId    Int
  printedBy String
  updatedBy String?
  createdAt String

  user User @relation(fields: [userId], references: [id])
}

model CartItem {
  id               Int    @id @default(autoincrement())
  quantity         Int
  cartId           Int
  itemPreferenceId Int
  inventoryUnitId  Int
  createdAt        String
  createdBy        String

  inventoryUnit  InventoryUnit  @relation(fields: [inventoryUnitId], references: [id])
  itemPreference ItemPreference @relation(fields: [itemPreferenceId], references: [id])
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

model Cart {
  id             Int     @id @default(autoincrement())
  subtotal       Float
  discount       Float
  GST            Float
  PST            Float
  shippingFee    Float
  totalPrice     Float
  note           String?
  userId         Int?
  guestSessionId String?
  createdAt      String
  createdBy      String

  items CartItem[]
  user  User?      @relation(fields: [userId], references: [id])
}