generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Company {
  id            Int     @id @default(autoincrement())
  name          String
  address       String?
  contactNumber String?
  email         String?
  createdAt     String
  createdBy     String

  actions           Action[]
  announcements     Announcement[]
  users             User[]
  employees         Employee[]
  orders            Orders[]
  transactions      Expense[]
  vendors           Vendor[]
  routes            Route[]
  shiftSessions     ShiftSession[]
  scheduledShifts   ScheduledShift[]
  inventoryItems    InventoryItem[]
  codBoards         CodBoard[]
  categories        Category[]
  fixedTransactions FixedTransaction[]
  paymentMethods    PaymentMethod[]
  purchaseOrders    PO[]
  poItems           POItem[]
  itemTypes         ItemType[]
  promotions        Promotion[]
  sellingItems      Item[]
  orderedItems      OrderedItems[]
  cheques           Cheque[]
  clientStatements  ClientStatement[]
  inventoryUnits    InventoryUnit[]
  fifos             Fifo[]
  vendorItems       VendorItem[]
  scheduledOrders   ScheduleOrders[]
  lossReports       LossReport[]
  unavailableRanges DayRange[]
  companyPages      CompanyPage[]
  quotes            Quote[]
  quoteItems        QuoteItem[]
  payrolls          Payroll[]
  deliveries        Delivery[]
  medias            Media[]
  batchTransactions BatchTransaction[]
  expenseTypes      ExpenseType[]
  automationRules   AutomationRules[]
  inventoryLogs     InventoryLog[]
  waterPrograms     WaterProgram[]
  zonePrograms      ZoneProgram[]
  programSchedules  ProgramSchedule[]
}

model PageView {
  id        Int     @id @default(autoincrement())
  title     String
  createdAt String?

  companyPages CompanyPage[]
  adminPages   AdminPage[]
}

model CompanyPage {
  id        Int @id @default(autoincrement())
  companyId Int
  pageId    Int

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pageView PageView @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model AdminPage {
  id         Int @id @default(autoincrement())
  employeeId Int
  pageId     Int

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pageView PageView @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Employee {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(255)
  password     String       @db.VarChar(255)
  hourlyRate   Float?
  payRate      Float?
  payrollType  PayrollType?
  employeeCode String
  email        String?
  notification Json?
  role         String?
  companyId    Int
  createdAt    String?
  createdBy    String?
  dashboardMode DashboardMode?

  shiftSessions   ShiftSession[]
  routes          Route[]
  CodBoard        CodBoard[]
  adminPages      AdminPage[]
  scheduledShifts ScheduledShift[]
  payrolls        Payroll[]
  deliveries      Delivery[]

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
}

model Payroll {
  id            Int            @id @default(autoincrement())
  employeeId    Int
  companyId     Int
  hours         Float
  total         Float
  status        PaymentStatus?
  startDate     String
  endDate       String
  createdAt     String
  createdBy     String
  transactionId Int?

  employee    Employee @relation(fields: [employeeId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id])
  transaction Expense? @relation(fields: [transactionId], references: [id])

  @@index([employeeId])
  @@index([companyId])
  @@index([startDate, endDate])
}

model Driver {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(255)
  password     String       @db.VarChar(255)
  hourlyRate   Float?
  notification Json?
  role         String?
  payrollType  PayrollType?

  shiftSessions ShiftSession[]
  routes        Route[]
  CodBoard      CodBoard[]
}

model User {
  id                 Int     @id @default(autoincrement())
  categoryId         Int?
  companyId          Int?
  clientName         String  @db.VarChar(255)
  clientId           String  @unique @db.VarChar(255)
  contactNumber      String  @db.VarChar(11)
  deliveryAddress    String  @db.VarChar(255)
  password           String  @db.VarChar(255)
  sheetName          String? @db.VarChar(255)
  role               String  @db.VarChar(255)
  email              String? @db.VarChar(255)
  userPreferenceId   Int?
  subCategoryId      Int?
  deliveryAddressLat Float?
  deliveryAddressLng Float?
  createdAt          String?
  type               String?
  guestSessionId     String?
  contactName        String?

  category    Category?       @relation(fields: [categoryId], references: [id])
  subCategory SubCategory?    @relation(fields: [subCategoryId], references: [id])
  preference  UserPreference? @relation(fields: [userPreferenceId], references: [id])
  company     Company?        @relation(fields: [companyId], references: [id])

  Orders              Orders[]
  scheduleOrders      ScheduleOrders[]
  routes              UserRoute[]
  unavailableDayRange DayRange[]
  printStatements     ClientStatement[]
  cart                Cart[]
  cheques             Cheque[]
  quotes              Quote[]

  @@index([userPreferenceId])
  @@index([categoryId])
}

model Quote {
  id        Int         @id @default(autoincrement())
  companyId Int?
  userId    Int
  status    QuoteStatus @default(DRAFT)
  subtotal  Float
  PST       Float
  GST       Float
  total     Float
  note      String
  createdAt String
  createdBy String

  items QuoteItem[]

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([status])
}

model QuoteItem {
  id              Int  @id @default(autoincrement())
  companyId       Int?
  quoteId         Int
  inventoryItemId Int
  inventoryUnitId Int
  quantity        Int
  price           Int

  quote         Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Category {
  id        Int    @id @default(autoincrement())
  name      String @unique @db.VarChar(255)
  companyId Int?

  company           Company?            @relation(fields: [companyId], references: [id])
  users             User[]
  items             Item[]
  itemType_category ItemType_Category[]
}

model SubCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(255)
  users User[]
  items Item[]
}

model Item {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  companyId       Int?
  categoryId      Int?
  price           Float
  availability    Boolean
  inventoryItemId Int?
  inventoryUnitId Int?
  isShowDiscount  Boolean?
  prevPrice       Float?
  image           String?
  promotionId     Int? // support for only item in website category
  isBestSeller    Boolean?
  createdAt       String?
  createdBy       String?

  options  Option[]
  cartItem CartItem[]

  promotion     Promotion?     @relation(fields: [promotionId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  inventoryUnit InventoryUnit? @relation(fields: [inventoryUnitId], references: [id])
  company       Company?       @relation(fields: [companyId], references: [id])
  SubCategory   SubCategory?   @relation(fields: [subCategoryId], references: [id])
  subCategoryId Int?

  @@index([categoryId])
  @@index([inventoryItemId])
  @@index([inventoryUnitId])
}

model OrderedItems {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(255)
  price            Float
  companyId        Int?
  orderId          Int?
  quantity         Int
  scheduledOrderId Int?
  expenseId        Int?
  inventoryItemId  Int?
  fifoId           Int?
  inventoryUnitId  Int?
  isShowDiscount   Boolean?
  prevPrice        Float?
  isCustomAmount   Boolean?
  cost             Float?
  profit           Float?
  option           Json?

  Orders         Orders?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  expense        Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fifo           Fifo?           @relation(fields: [fifoId], references: [id])
  inventoryUnit  InventoryUnit?  @relation(fields: [inventoryUnitId], references: [id])
  inventoryItem  InventoryItem?  @relation(fields: [inventoryItemId], references: [id])
  ScheduleOrders ScheduleOrders? @relation(fields: [scheduledOrderId], references: [id], onDelete: Cascade)
  company        Company?        @relation(fields: [companyId], references: [id])

  @@index([orderId])
  @@index([companyId])
  @@index([expenseId])
  @@index([scheduledOrderId])
  @@index([inventoryItemId])
  @@index([orderId, inventoryItemId])
}

model Orders {
  id                   Int            @id @default(autoincrement())
  orderTime            String
  deliveryDate         String
  note                 String
  status               String
  paymentStatus        PaymentStatus?
  userId               Int
  totalPrice           Float
  isReplacement        Boolean?
  isVoid               Boolean?
  updateTime           DateTime?
  createdBy            String?
  updatedBy            String?
  codBoardId           Int?
  GST                  Float?
  PST                  Float?
  subTotal             Float?
  discount             Float?
  isAffectInventory    Boolean?
  shippingFee          Float?
  type                 String?
  deliveredBy          String?
  deliveredAt          String?
  addedToCODBy         String?
  insertedAt           String?
  insertedBy           String?
  companyId            Int?
  hasSubtractInventory Boolean?
  enteredOrderAt       String?
  isCODCheck           Boolean?

  delivery Delivery? @relation("OrderDelivery")

  items    OrderedItems[]
  logs     InventoryLog[]
  timeline OrderTimeline? @relation("OrderTimeline")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id])
  CodBoard     CodBoard?     @relation(fields: [codBoardId], references: [id])
  reassignment Reassignment? @relation("OrderReassignment")

  @@index([deliveryDate, status])
  @@index([deliveryDate, status, paymentStatus])
  @@index([deliveryDate])
  @@index([userId])
  @@index([companyId])
}

model Delivery {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique
  employeeId  Int
  deliveredAt String?
  companyId   Int?
  startTripAt String?
  isViewed    Boolean?

  medias Media[]

  order    Orders   @relation("OrderDelivery", fields: [orderId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])
  company  Company? @relation(fields: [companyId], references: [id])

  @@index([orderId])
  @@index([employeeId])
  @@index([companyId])
  @@index([deliveredAt])
}

model OrderTimeline {
  id      Int           @id @default(autoincrement())
  orderId Int           @unique
  actions OrderAction[]

  order Orders @relation("OrderTimeline", fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderAction {
  id         Int     @id @default(autoincrement())
  timelineId Int
  title      String
  comment    String? @db.Text
  createdAt  String
  createdBy  String
  posIndex   Int

  timeline OrderTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id          Int     @id @default(autoincrement())
  orderType   String?
  paymentType String?
  userId      Int
  User        User[]

  @@index([userId])
  @@index([paymentType])
}

model ScheduleOrders {
  id            Int            @id @default(autoincrement())
  companyId     Int?
  totalPrice    Float
  userId        Int
  day           String
  items         OrderedItems[]
  positionIndex PositionIndex? @relation("ScheduledOrderIndex")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([day])
}

model PositionIndex {
  id               Int @id @default(autoincrement())
  scheduledOrderId Int @unique
  index            Int

  scheduledOrder ScheduleOrders @relation("ScheduledOrderIndex", fields: [scheduledOrderId], references: [id], onDelete: Cascade)
}

model Reassignment {
  id           Int                @id @default(autoincrement())
  fromRouteId  Int?
  toRouteId    Int
  index        Int
  date         String
  reassignedAt String
  reassignedBy String
  reason       String?
  status       ReassignmentStatus
  orderId      Int                @unique

  from  Route?  @relation("FromRoute", fields: [fromRouteId], references: [id], onDelete: Cascade)
  to    Route  @relation("ToRoute", fields: [toRouteId], references: [id], onDelete: Cascade)
  order Orders @relation("OrderReassignment", fields: [orderId], references: [id], onDelete: Cascade)
}

model Route {
  id         Int    @id @default(autoincrement())
  day        String
  driverId   Int
  employeeId Int?
  name       String
  companyId  Int?

  clients          UserRoute[]
  shiftSessions    ShiftSession[]
  reassignmentFrom Reassignment[] @relation("FromRoute")
  reassignmentTo   Reassignment[] @relation("ToRoute")

  driver   Driver    @relation(fields: [driverId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([day, companyId])
}

model UserRoute {
  userId  Int
  routeId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  route   Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([userId, routeId])
  @@index([routeId])
  @@index([userId])
}

model DayRange {
  id         Int      @id @default(autoincrement())
  companyId  Int?
  startDate  DateTime
  endDate    DateTime
  userId     Int
  createdAt  String?
  createdBy  String?
  isArchived Boolean?

  company Company? @relation(fields: [companyId], references: [id])
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id           Int      @id @default(autoincrement())
  companyId    Int?
  updatedBy    String
  updatedAt    DateTime
  announcement String

  company Company? @relation(fields: [companyId], references: [id])
}

model CodBoard {
  id         Int     @id @default(autoincrement())
  createdAt  String
  createdBy  String
  updatedAt  String?
  updatedBy  String?
  date       String
  note       String
  cash       Float
  status     String
  driverId   Int?
  employeeId Int?
  companyId  Int?

  orders  Orders[]
  expense Expense[]

  driver   Driver?   @relation(fields: [driverId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model PaymentMethod {
  id        Int     @id @default(autoincrement())
  createdAt String
  createdBy String
  name      String
  balance   Float
  type      String
  updatedAt String?
  updatedBy String?
  companyId Int?

  transactions      Expense[]
  fixedTransactions FixedTransaction[]
  batchTransactions BatchTransaction[]

  company Company? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model FixedTransaction {
  id                       Int     @id @default(autoincrement())
  title                    String
  companyId                Int?
  defaultSubtotal          Float?
  defaultAmount            Float?
  defaultPST               Float?
  defaultGST               Float?
  recurrence               String // monthly, quarterly, etc
  initialDueDate           String
  nextDueDate              String
  lastGeneratedAt          String?
  note                     String?
  createdAt                String
  createdBy                String
  updatedAt                String?
  updatedBy                String?
  status                   String
  defaultSpentBy           String?
  defaultTransactionStatus String? // Paid & Unpaid
  paymentMethodId          Int

  transactions Expense[]

  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Expense {
  id              Int     @id @default(autoincrement())
  createdAt       String
  createdBy       String
  subTotal        Float?
  PST             Float?
  GST             Float?
  amount          Float
  discount        Float?
  description     String
  spentBy         String
  paymentMethodId Int
  date            String
  codBoardId      Int?
  invoice         String?
  status          String?
  paidAt          String?

  typeId             Int?
  fixedTransactionId Int?
  companyId          Int?
  batchTransactionId Int?
  mergeChequeId      Int?

  paymentMethod    PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  codBoard         CodBoard?         @relation(fields: [codBoardId], references: [id])
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batchTransaction BatchTransaction? @relation(fields: [batchTransactionId], references: [id], onDelete: Cascade)
  mergeCheque      Cheque?           @relation(fields: [mergeChequeId], references: [id])
  type             ExpenseType?      @relation(fields: [typeId], references: [id])

  orderedItems     OrderedItems[]
  vendors          VendorExpense[]
  shifts           ShiftSession[]
  purchaseOrders   PO[]
  payrolls         Payroll[]
  cheques          Media[]
  logs             InventoryLog[]
  fixedTransaction FixedTransaction? @relation(fields: [fixedTransactionId], references: [id])

  @@index([date])
  @@index([typeId])
  @@index([paymentMethodId])
  @@index([companyId])
}

model ExpenseType {
  id        Int    @id @default(autoincrement())
  name      String
  companyId Int

  transactions      Expense[]
  batchTransactions BatchTransaction[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model BatchTransaction {
  id              Int            @id @default(autoincrement())
  createdAt       String
  createdBy       String
  description     String?
  date            String
  startDate       String
  endDate         String
  discount        Float?
  subTotal        Float?
  total           Float?
  PST             Float?
  GST             Float?
  companyId       Int?
  spentBy         String
  paymentMethodId Int
  status          PaymentStatus?
  typeId          Int?

  transactions Expense[]
  cheques      Media[]

  company       Company?      @relation(fields: [companyId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  type          ExpenseType?  @relation(fields: [typeId], references: [id])

  @@index([date])
  @@index([typeId])
}

model VendorExpense {
  expenseId Int
  vendorId  Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([expenseId, vendorId])
  @@index([vendorId])
  @@index([expenseId])
}

model Vendor {
  id          Int     @id @default(autoincrement())
  name        String
  address     String
  addressLat  Float?
  addressLng  Float?
  phoneNumber String?
  createdAt   String
  createdBy   String
  joinedDate  String
  email       String?
  companyId   Int?

  company Company? @relation(fields: [companyId], references: [id])

  expense        VendorExpense[]
  vendorItem     VendorItem[]
  purchaseOrders PO[]
  payments       Cheque[]
}

model InventoryItem {
  id              Int      @id @default(autoincrement())
  name            String
  sku             String?
  supplierSku     String?
  createdAt       String
  createdBy       String
  hasGST          Boolean?
  hasPST          Boolean?
  typeId          Int?
  color           String?
  indexPos        Int?
  image           String?
  isPromotion     Boolean?
  promotionId     Int?
  promoIndexPos   Int?
  companyId       Int?
  isShowInventory Boolean?
  isInternal      Boolean?

  item                   Item[]
  vendorItem             VendorItem[]
  fifo                   Fifo[]
  OrderedItems           OrderedItems[]
  preference             ItemPreference[]
  options                Option[]
  poItems                POItem[]
  lossReports            LossReport[]
  quoteItems             QuoteItem[]
  logs                   InventoryLog[]
  subtractRules          AutomationRules[] @relation("InventoryItemRules")
  dependentSubtractRules AutomationRules[] @relation("DependentInventoryItemRules")

  company   Company?               @relation(fields: [companyId], references: [id])
  promotion Promotion?             @relation(fields: [promotionId], references: [id])
  type      ItemType?              @relation(fields: [typeId], references: [id])
  timeline  InventoryItemTimeline? @relation("InventoryItemTimeline")

  @@index([indexPos])
  @@index([promoIndexPos])
  @@index([typeId, indexPos])
}

model AutomationRules {
  id                       Int     @id @default(autoincrement())
  inventoryItemId          Int
  dependentInventoryItemId Int?
  companyId                Int
  relationalQty            Float?
  subtractQty              Float
  frequency                String?
  nextSubtractDate         String?
  lastSubtractAt           String?
  isActive                 Boolean
  createdAt                String
  createdBy                String

  inventoryItem          InventoryItem  @relation("InventoryItemRules", fields: [inventoryItemId], references: [id], onDelete: Cascade)
  dependentInventoryItem InventoryItem? @relation("DependentInventoryItemRules", fields: [dependentInventoryItemId], references: [id], onDelete: Cascade)
  company                Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([dependentInventoryItemId])
  @@index([inventoryItemId])
}

model InventoryLog {
  id              Int              @id @default(autoincrement())
  companyId       Int
  inventoryItemId Int
  log             String
  type            InventoryLogType
  prevQty         Float
  afterQty        Float
  quantity        Float
  date            String
  createdAt       String
  createdFrom     InventoryLogFrom
  orderId         Int?
  transactionId   Int?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order         Orders?       @relation(fields: [orderId], references: [id])
  transaction   Expense?      @relation(fields: [transactionId], references: [id])

  @@index([inventoryItemId])
  @@index([date])
}

model ItemPreference {
  id              Int           @id @default(autoincrement())
  image           String
  inventoryItemId Int
  typeId          Int
  description     String
  isBestSeller    Boolean
  createdAt       String?
  createdBy       String?
  price           Float
  isShowDiscount  Boolean?
  prevPrice       Float?
  inventoryUnitId Int
  name            String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            ItemType      @relation(fields: [typeId], references: [id], onDelete: Cascade)
  inventoryUnit   InventoryUnit @relation(fields: [inventoryUnitId], references: [id])
}

model ItemType {
  id        Int     @id @default(autoincrement())
  companyId Int?
  name      String  @unique
  createdAt String?
  createdBy String?
  icon      String?
  priority  Int?
  rows      Int?

  company           Company?            @relation(fields: [companyId], references: [id])
  itemPreferences   ItemPreference[]
  inventoryItems    InventoryItem[]
  itemType_category ItemType_Category[]
}

model ItemType_Category {
  itemTypeId Int
  categoryId Int
  priority   Int
  itemType   ItemType @relation(fields: [itemTypeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([itemTypeId, categoryId])
}

model VendorItem {
  id              Int     @id @default(autoincrement())
  companyId       Int?
  inventoryItemId Int
  vendorId        Int
  quantity        Float
  createdAt       String
  createdBy       String
  supplierSku     String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  vendor        Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id])

  fifo Fifo[]
  unit InventoryUnit[]

  @@index([vendorId])
  @@index([inventoryItemId])
  @@index([inventoryItemId, vendorId])
}

model Fifo {
  id              Int    @id @default(autoincrement())
  companyId       Int?
  inventoryItemId Int
  vendorItemId    Int
  quantity        Float
  createdAt       String
  createdBy       String
  price           Float?

  orderedItems OrderedItems[]

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id])
  vendorItem    VendorItem    @relation(fields: [vendorItemId], references: [id])

  @@index([inventoryItemId])
  @@index([vendorItemId])
}

model InventoryUnit {
  id           Int    @id @default(autoincrement())
  vendorItemId Int
  companyId    Int?
  unit         String
  unitPrice    Float  @db.Double
  ratio        Float
  createdAt    String
  createdBy    String

  company Company? @relation(fields: [companyId], references: [id])

  sellingItem     Item[]
  itemOptions     Option[]
  vendorItem      VendorItem       @relation(fields: [vendorItemId], references: [id], onDelete: Cascade)
  orderedItems    OrderedItems[]
  itemPreferences ItemPreference[]
  poItems         POItem[]
  lossReports     LossReport[]
  quoteItems      QuoteItem[]

  @@index([vendorItemId])
}

model InventoryItemTimeline {
  id              Int      @id @default(autoincrement())
  inventoryItemId Int?     @unique
  actions         Action[]

  inventoryItem InventoryItem? @relation("InventoryItemTimeline", fields: [inventoryItemId], references: [id])
}

model Action {
  id                      Int     @id @default(autoincrement())
  name                    String
  description             String? @db.Text
  companyId               Int?
  date                    String
  createdAt               String
  createdBy               String?
  inventoryItemTimelineId Int?

  iventoryItemTimeline InventoryItemTimeline? @relation(fields: [inventoryItemTimelineId], references: [id], onDelete: Cascade)

  company Company? @relation(fields: [companyId], references: [id])
}

model Cheque {
  id           Int     @id @default(autoincrement())
  companyId    Int?
  fileKeyFront String
  fileKeyBack  String?
  month        String?
  year         String
  startDate    String?
  endDate      String?
  chequeNumber String?
  amount       Float
  createdAt    String
  createdBy    String

  userId   Int? // user pay to company
  vendorId Int? // company pay to vendor

  transactions Expense[]

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor  Vendor?  @relation(fields: [vendorId], references: [id])
}

model ClientStatement {
  id        Int     @id @default(autoincrement())
  companyId Int?
  month     String
  isPrinted Boolean
  userId    Int
  createdAt String
  printedBy String
  updatedBy String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])
}

model CartItem {
  id        Int    @id @default(autoincrement())
  quantity  Int
  cartId    Int
  itemId    Int
  createdAt String
  createdBy String
  option    Json?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

model Cart {
  id             Int        @id @default(autoincrement())
  subtotal       Float
  GST            Float
  PST            Float
  shippingFee    Float
  totalPrice     Float
  note           String?
  userId         Int?
  discount       Float
  createdAt      String
  createdBy      String
  guestSessionId String?
  items          CartItem[]
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Promotion {
  id         Int      @id @default(autoincrement())
  companyId  Int?
  title      String
  status     String
  createdAt  String
  rows       Int
  priority   Int
  visibility Boolean?
  isWebsite  Boolean?

  items        InventoryItem[]
  websiteItems Item[]

  company Company? @relation(fields: [companyId], references: [id])
}

model Option {
  id              Int      @id @default(autoincrement())
  name            String
  price           Float
  prevPrice       Float?
  isShowDiscount  Boolean?
  availability    Boolean
  inventoryItemId Int
  createdAt       String?
  createdBy       String?

  unitId Int
  itemId Int

  unit          InventoryUnit @relation(fields: [unitId], references: [id])
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model ScheduledShift {
  id         Int                   @id @default(autoincrement())
  companyId  Int
  employeeId Int
  date       String
  queryDate  String? // Use for query
  startedAt  String
  endedAt    String?
  hours      Float?
  cost       Float?
  role       String
  assignedAt String?
  assignedBy String?
  createdAt  String
  createdBy  String
  status     ScheduledShiftStatus?
  isOff      Boolean?
  isSkip     Boolean?

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([queryDate])
}

model ShiftSession {
  id         Int      @id @default(autoincrement())
  driverId   Int?
  employeeId Int?
  routeId    Int?
  date       String
  startedAt  String
  endedAt    String?
  hours      Float?
  isActive   Boolean?
  cost       Float?
  status     String?
  expenseId  Int?
  role       String?
  companyId  Int?

  driver   Driver?    @relation(fields: [driverId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  expense  Expense?  @relation(fields: [expenseId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  route    Route?    @relation(fields: [routeId], references: [id])
}

model PO {
  id         Int     @id @default(autoincrement())
  companyId  Int?
  poNumber   String?
  vendorId   Int
  status     String
  discount   Float?
  totalCost  Float
  tax        Float
  subtotal   Float
  estArrival String
  createdAt  String
  createdBy  String
  receivedAt String?
  note       String?
  expenseId  Int?

  company Company? @relation(fields: [companyId], references: [id])

  vendor  Vendor   @relation(fields: [vendorId], references: [id])
  poItems POItem[]
  expense Expense? @relation(fields: [expenseId], references: [id])

  @@index([vendorId])
}

model POItem {
  id              Int     @id @default(autoincrement())
  inventoryItemId Int
  companyId       Int?
  poId            Int
  orderedQty      Float
  receivedQty     Float?
  rejectedQty     Float?
  tax             Float?
  costPerItem     Float
  note            String?
  inventoryUnitId Int

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])
  po            PO            @relation(fields: [poId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id])

  @@index([poId])
  @@index([inventoryItemId])
}

model LossReport {
  id              Int     @id @default(autoincrement())
  companyId       Int?
  inventoryItemId Int
  quantityLost    Int
  inventoryUnitId Int
  totalCost       Float?
  lossType        String
  description     String?
  reportedDate    String
  reportedBy      String
  createdAt       String
  createdBy       String

  medias Media[]

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])
  company       Company?      @relation(fields: [companyId], references: [id])
}

model Media {
  id        Int     @id @default(autoincrement())
  type      String
  fileKey   String
  createdAt String
  createdBy String
  note      String?

  companyId          Int?
  lossReportId       Int?
  deliveryId         Int?
  expenseId          Int?
  batchTransactionId Int?

  lossReport       LossReport?       @relation(fields: [lossReportId], references: [id], onDelete: Cascade)
  delivery         Delivery?         @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  expense          Expense?          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batchTransaction BatchTransaction? @relation(fields: [batchTransactionId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([lossReportId])
  @@index([expenseId])
}

model ZoneProgram {
  id         Int  @id @default(autoincrement())
  zoneId     Int
  duration   Int
  index      Int
  createdAt  String
  createdBy  String
  companyId  Int

  zoneWaterPrograms  ZoneWater[]

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model WaterProgram {
  id                  Int   @id  @default(autoincrement())
  name                String
  days                Int
  remainingDays       Int?
  isActive            Boolean     @default(false)
  createdAt           String
  createdBy           String
  companyId           Int

  zoneWaterPrograms   ZoneWater[]
  ProgramSchedules    ProgramSchedule[]

  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ZoneWater {
  id              Int      @id  @default(autoincrement())
  zoneProgramId   Int
  waterId         Int

  zoneProgram     ZoneProgram    @relation(fields: [zoneProgramId], references: [id], onDelete: Cascade)
  WaterProgram    WaterProgram   @relation(fields: [waterId], references: [id], onDelete: Cascade)

  @@index([zoneProgramId])
  @@index([waterId])          
}

model ProgramSchedule {
  id              Int   @id   @default(autoincrement())
  programId       Int
  status          WaterStatus
  date            String
  time            String
  createdAt       String
  createdBy       String
  companyId       Int

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  waterProgram    WaterProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
}


enum QuoteStatus {
  DRAFT
  SENT
  CONVERTED
  REJECTED
}

enum ScheduledShiftStatus {
  PUBLISHED
  UNPUBLISHED
}

enum PayrollType {
  hourly
  monthly
}

enum PaymentStatus {
  Paid
  Unpaid
}

enum ReassignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InventoryLogType {
  SUBTRACT
  STOCK_IN
  RESTOCK
  LOST
}

enum InventoryLogFrom {
  CREATE_ORDER
  DELETE_ORDER
  EDIT_ORDER
  CREATE_TRANSACTION
  EDIT_TRANSACTION
  DELETE_TRANSACTION
  CREATE_LOSS_REPORT
  EDIT_LOSS_REPORT
  DELETE_LOSS_REPORT

  DEPENDENT_INVENTORY
  AUTOMATIC_SUBTRACT
}

enum DashboardMode {
  auto
  driver
}

enum WaterStatus {
  SCHEDULED
  ACTIVE
  FINISHED
}